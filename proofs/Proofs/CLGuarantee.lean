/-
# General guarantee for CLTR: Theorem 3.12 and the exact-balanced special case

* `bregman`: the Bregman divergence `D_Ψ(x, y) = Ψ x - Ψ y - ⟨∇Ψ(y), x - y⟩`, and its
  nonnegativity for convex differentiable `Ψ` (used implicitly in the paper: `α D_Φ ≥ 0`).
* `theorem3_12`: if `β ≥ β_min = L_H^sm/(2 m_Ψ)` (parameter route) or `α ≥ α_min = c_Φ/2`
  (output route), then `𝓛_bal(θ) ≤ 𝓛_CL(θ) + ½ 𝓛_H(θ_H*)` on `𝒩` (Eq. (eq:dominance)).
* `propC2_exact_balanced`: with `Ψ = 𝓛_H`, `α = 0`, `β = ½`, `𝓛_task = ½ 𝓛_T`,
  `𝓛_CL = 𝓛_bal - ½ 𝓛_H(θ_H*)`; hence identical gradients and identical minimizers.

The divergences are modelled as functions of `θ` (`Dφ θ = D_Φ(h_θ(·), z)`, `Dψ θ = D_Ψ(θ, θ_H*)`)
since Theorem 3.12 only uses them through Assumption 3.11 and nonnegativity.
-/
import Mathlib

open Set

namespace CLTR

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Bregman divergence generated by `Ψ`. -/
noncomputable def bregman (Ψ : E → ℝ) (x y : E) : ℝ :=
  Ψ x - Ψ y - fderiv ℝ Ψ y (x - y)

/-- Bregman divergences of convex differentiable generators are nonnegative. -/
theorem bregman_nonneg {Ψ : E → ℝ} (hΨ : ConvexOn ℝ univ Ψ) {y : E}
    (hd : DifferentiableAt ℝ Ψ y) (x : E) : 0 ≤ bregman Ψ x y := by
  -- restrict `Ψ` to the line `t ↦ y + t (x - y)`
  set g : ℝ → ℝ := fun t => Ψ (t • (x - y) + y) with hg
  have hgc : ConvexOn ℝ univ g := by
    have := hΨ.comp_affineMap (AffineMap.lineMap y x)
    simpa [Function.comp_def, AffineMap.lineMap_apply, hg] using this
  have hline : HasDerivAt (fun t : ℝ => t • (x - y) + y) (x - y) 0 := by
    simpa using ((hasDerivAt_id (0 : ℝ)).smul_const (x - y)).add_const y
  have hgd : HasDerivAt g (fderiv ℝ Ψ y (x - y)) 0 := by
    have h := hd.hasFDerivAt
    rw [show y = (0 : ℝ) • (x - y) + y by simp] at h
    simpa [hg, Function.comp_def] using h.comp_hasDerivAt (0 : ℝ) hline
  have := hgc.le_slope_of_hasDerivAt (mem_univ 0) (mem_univ 1) zero_lt_one hgd
  simp [slope, hg] at this
  unfold bregman
  rw [map_sub]
  linarith

variable (LH LT Dφ Dψ : E → ℝ) (α β : ℝ)

/-- Unified CL objective, Eq. (eq:wang-app), with `𝓛_task = 𝓛_T` (CLTR stage 2). -/
noncomputable def clObj (θ : E) : ℝ := LT θ + α * Dφ θ + β * Dψ θ

/-- Balanced LTR objective `𝓛_bal = ½ 𝓛_H + ½ 𝓛_T`. -/
noncomputable def balObj (θ : E) : ℝ := (1 / 2) * LH θ + (1 / 2) * LT θ

variable {LH LT Dφ Dψ α β}

/-- Eq. (first_ineq2-app): `𝓛_bal ≤ 𝓛_task + ½(𝓛_H(θ) - 𝓛_H(θ_H*)) + ½ 𝓛_H(θ_H*)`. -/
theorem bal_le_task_add {θH θ : E} (hLT : 0 ≤ LT θ) :
    balObj LH LT θ ≤ LT θ + (1 / 2) * (LH θ - LH θH) + (1 / 2) * LH θH := by
  unfold balObj; linarith

/-- **Theorem 3.12, parameter route.** Head smoothness (Eq. (eq:head-smooth)) and `m_Ψ`-strong
convexity of `D_Ψ(·, θ_H*)` (Eq. (eq:psi-strong)) with `β ≥ L_H^sm / (2 m_Ψ)`. -/
theorem theorem3_12_param {N : Set E} {θH : E} {Lsm mψ : ℝ} (hLsm : 0 ≤ Lsm) (hmψ : 0 < mψ)
    (hα : 0 ≤ α) (hLT : ∀ θ ∈ N, 0 ≤ LT θ) (hDφ : ∀ θ ∈ N, 0 ≤ Dφ θ)
    (hsmooth : ∀ θ ∈ N, LH θ ≤ LH θH + Lsm / 2 * ‖θ - θH‖ ^ 2)
    (hstrong : ∀ θ ∈ N, mψ / 2 * ‖θ - θH‖ ^ 2 ≤ Dψ θ)
    (hβ : Lsm / (2 * mψ) ≤ β) :
    ∀ θ ∈ N, balObj LH LT θ ≤ clObj LT Dφ Dψ α β θ + (1 / 2) * LH θH := by
  intro θ hθ
  have h1 := bal_le_task_add (LH := LH) (θH := θH) (hLT θ hθ)
  -- Eq. (eq:head-dom-psi-app): `½(𝓛_H θ - 𝓛_H θ_H*) ≤ L/(2m) D_Ψ`
  have h2 : (1 / 2) * (LH θ - LH θH) ≤ Lsm / (2 * mψ) * Dψ θ := by
    have hs := hsmooth θ hθ
    have hq : ‖θ - θH‖ ^ 2 ≤ 2 / mψ * Dψ θ := by
      rw [div_mul_eq_mul_div, le_div_iff₀ hmψ]; nlinarith [hstrong θ hθ]
    calc (1 / 2) * (LH θ - LH θH) ≤ (1 / 2) * (Lsm / 2 * ‖θ - θH‖ ^ 2) := by gcongr; linarith
      _ ≤ (1 / 2) * (Lsm / 2 * (2 / mψ * Dψ θ)) := by gcongr
      _ = Lsm / (2 * mψ) * Dψ θ := by field_simp
  have hDψ : 0 ≤ Dψ θ := le_trans (by positivity) (hstrong θ hθ)
  -- Eq. (half_beta-app)
  have h3 : Lsm / (2 * mψ) * Dψ θ ≤ β * Dψ θ := mul_le_mul_of_nonneg_right hβ hDψ
  have h4 : 0 ≤ α * Dφ θ := mul_nonneg hα (hDφ θ hθ)
  unfold clObj
  linarith

/-- **Theorem 3.12, output route.** Output calibration (Eq. (eq:phi-calib)) with `α ≥ c_Φ / 2`. -/
theorem theorem3_12_output {N : Set E} {θH : E} {cφ : ℝ}
    (hβ : 0 ≤ β) (hLT : ∀ θ ∈ N, 0 ≤ LT θ) (hDφ : ∀ θ ∈ N, 0 ≤ Dφ θ)
    (hDψ : ∀ θ ∈ N, 0 ≤ Dψ θ)
    (hcalib : ∀ θ ∈ N, LH θ - LH θH ≤ cφ * Dφ θ) (hα : cφ / 2 ≤ α) :
    ∀ θ ∈ N, balObj LH LT θ ≤ clObj LT Dφ Dψ α β θ + (1 / 2) * LH θH := by
  intro θ hθ
  have h1 := bal_le_task_add (LH := LH) (θH := θH) (hLT θ hθ)
  have h2 := hcalib θ hθ
  have h3 : cφ / 2 * Dφ θ ≤ α * Dφ θ := mul_le_mul_of_nonneg_right hα (hDφ θ hθ)
  have h4 : 0 ≤ β * Dψ θ := mul_nonneg hβ (hDψ θ hθ)
  unfold clObj
  linarith

/-- **Theorem 3.12** (Eq. (eq:dominance)). Under Assumption 3.11 on `𝒩`, if `β ≥ β_min` or
`α ≥ α_min`, then `𝓛_bal(θ) ≤ 𝓛_CL(θ) + ½ 𝓛_H(θ_H*)` for every `θ ∈ 𝒩`. -/
theorem theorem3_12 {N : Set E} {θH : E} {Lsm mψ cφ : ℝ} (hLsm : 0 ≤ Lsm) (hmψ : 0 < mψ)
    (hα : 0 ≤ α) (hβ : 0 ≤ β) (hLT : ∀ θ ∈ N, 0 ≤ LT θ) (hDφ : ∀ θ ∈ N, 0 ≤ Dφ θ)
    (hsmooth : ∀ θ ∈ N, LH θ ≤ LH θH + Lsm / 2 * ‖θ - θH‖ ^ 2)
    (hstrong : ∀ θ ∈ N, mψ / 2 * ‖θ - θH‖ ^ 2 ≤ Dψ θ)
    (hcalib : ∀ θ ∈ N, LH θ - LH θH ≤ cφ * Dφ θ)
    (hroute : Lsm / (2 * mψ) ≤ β ∨ cφ / 2 ≤ α) :
    ∀ θ ∈ N, balObj LH LT θ ≤ clObj LT Dφ Dψ α β θ + (1 / 2) * LH θH := by
  rcases hroute with h | h
  · exact theorem3_12_param hLsm hmψ hα hLT hDφ hsmooth hstrong h
  · exact theorem3_12_output hβ hLT hDφ
      (fun θ hθ => le_trans (by positivity) (hstrong θ hθ)) hcalib h

/-- **Proposition C.2 (exact equality up to a constant).** With `Ψ = 𝓛_H`, `α = 0`, `β = ½` and
`𝓛_task = ½ 𝓛_T`, `𝓛_CL(θ) = ½ 𝓛_T(θ) + ½ D_{𝓛_H}(θ, θ_H*) = 𝓛_bal(θ) - ½ 𝓛_H(θ_H*)`.
Only the minimality of `θ_H*` is needed (it forces `∇𝓛_H(θ_H*) = 0`). -/
theorem propC2_exact_balanced {θH : E} (hmin : ∀ θ, LH θH ≤ LH θ) (Dφ' : E → ℝ) (θ : E) :
    (1 / 2) * LT θ + 0 * Dφ' θ + (1 / 2) * bregman LH θ θH =
      balObj LH LT θ - (1 / 2) * LH θH := by
  have hloc : IsLocalMin LH θH := Filter.Eventually.of_forall hmin
  unfold bregman balObj
  rw [hloc.fderiv_eq_zero]
  simp
  ring

/-- Consequence: `𝓛_CL` and `𝓛_bal` have identical gradients. -/
theorem propC2_exact_balanced_fderiv {θH : E} (hmin : ∀ θ, LH θH ≤ LH θ) (θ : E) :
    fderiv ℝ (fun θ => (1 / 2) * LT θ + (1 / 2) * bregman LH θ θH) θ =
      fderiv ℝ (balObj LH LT) θ := by
  have : (fun θ => (1 / 2) * LT θ + (1 / 2) * bregman LH θ θH) =
      fun θ => balObj LH LT θ - (1 / 2) * LH θH := by
    funext θ; simpa using propC2_exact_balanced (LT := LT) hmin (fun _ => 0) θ
  rw [this, fderiv_sub_const]

/-- Consequence: `𝓛_CL` and `𝓛_bal` have the same minimizers. -/
theorem propC2_exact_balanced_minimizers {θH : E} (hmin : ∀ θ, LH θH ≤ LH θ) (θ₀ : E) :
    (∀ θ, (1 / 2) * LT θ₀ + (1 / 2) * bregman LH θ₀ θH ≤
        (1 / 2) * LT θ + (1 / 2) * bregman LH θ θH) ↔
      (∀ θ, balObj LH LT θ₀ ≤ balObj LH LT θ) := by
  have h : ∀ θ, (1 / 2) * LT θ + (1 / 2) * bregman LH θ θH =
      balObj LH LT θ - (1 / 2) * LH θH := fun θ => by
    simpa using propC2_exact_balanced (LT := LT) hmin (fun _ => 0) θ
  simp only [h, sub_le_sub_iff_right]

end CLTR
